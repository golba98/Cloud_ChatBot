# Copy this file to .dev.vars for local development with wrangler.
# Never commit .dev.vars — it is gitignored.
#
# The Cloudflare Workers AI binding (AI) is configured in the Pages dashboard,
# not via an API key. No key is needed for the default Cloudflare setup.

MODEL_PROVIDER=cloudflare

# Optional: switch to OpenAI instead of Cloudflare Workers AI.
# Set MODEL_PROVIDER=openai and provide your key below.
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
# OPENAI_MODEL=gpt-4o-mini
